{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Railway — Login (once)",
      "type": "shell",
      "command": "npx @railway/cli login",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "2. Railway — Link service (once)",
      "type": "shell",
      "command": "npx @railway/cli link",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "3. Railway — Deploy from VS Code (railway up)",
      "type": "shell",
      "command": "npm run deploy:railway",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Git — Push to GitHub",
      "type": "shell",
      "command": "git push origin main",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    }
  ]
}
