PORT=3000
JWT_SECRET=replace-with-long-random-secret-at-least-32-chars

# Aiven MySQL — copy from Aiven Console → your service → Connection parameters
DB_HOST=mysql-xxxxx-xxxxx.aivencloud.com
DB_PORT=17100
DB_USER=avnadmin
DB_PASSWORD=your-service-password
DB_NAME=defaultdb

# SSL CA (preferred for cloud deploy): paste the Aiven CA certificate PEM here.
# If unset, the server will try to read `server/ca.pem` when present.
# DB_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Optional: seed/ensure an admin account exists in Aiven
BINBUDDY_ADMIN_EMAIL=admin@email.com
# Recommend a strong password. Default seed uses password123 (see sql/aiven-reset-binbuddy.sql)
BINBUDDY_ADMIN_PASSWORD=password123

# Optional: longer timeouts if Aiven is slow to accept connections (milliseconds)
# DB_CONNECT_TIMEOUT_MS=20000
# DB_PING_TIMEOUT_MS=15000

# Set to true only for local MySQL without SSL (not for Aiven)
# DB_SSL_DISABLE=false
